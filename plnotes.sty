% Code: Racket and plai-typed
\RequirePackage{listings}
\lstdefinelanguage{Racket}{
  morekeywords={define,lambda,cond,else,if,let,let*,letrec,match,match*,
    case,type-case,define-type,struct,begin,and,or,require,module,
    test,test/exn,check-expect,check-error,check-equal?,typed-in},
  sensitive=true,
  alsoletter={-,?,!,*,/,>,<,=},
  morecomment=[l]{;},
  morestring=[b]",
}
\lstset{
  language=Racket,
  basicstyle=\ttfamily\small,
  keywordstyle=\bfseries,
  commentstyle=\itshape\color{cmt},
  stringstyle=\color{black!75},
  columns=fullflexible,
  keepspaces=true,
  upquote=true,
  showstringspaces=false,
  frame=lines,
  xleftmargin=1em,
  xrightmargin=1em,
  aboveskip=8pt,
  belowskip=8pt,
}
% REPL transcripts and traces: no keyword highlighting
\lstdefinestyle{repl}{language={}, basicstyle=\ttfamily\small, frame=leftline, framerule=1.2pt, rulecolor=\color{accent!50}}
\newcommand{\rkt}{\lstinline[language=Racket,basicstyle=\ttfamily,keywordstyle={}]}

% Headers and footers
\RequirePackage{fancyhdr}
\newcommand{\coursename}{CSCI-GA 2110}
\newcommand{\footernote}{Programming Languages (CSCI-GA 2110), NYU Courant, Fall 2026. Notes by You Li.}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[L]{\small\coursename\quad\parbox[b]{0.56\textwidth}{\raggedright\nouppercase{\rightmark}}}
\fancyfoot[L]{\small\footernote}
\fancyfoot[R]{\small\thepage}
\renewcommand{\sectionmark}[1]{\markright{\thesection.\ #1}}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\small\thepage}}

% Chapter and section headings
\RequirePackage{titlesec}
\titleformat{\chapter}[display]
  {\normalfont\bfseries}
  {\huge\chaptertitlename\ \thechapter}
  {20pt}
  {\Huge\raggedright}
\titlespacing*{\chapter}{0pt}{60pt}{30pt}
\titleformat{\section}{\normalfont\Large\bfseries}{\thesection}{1em}{}
% Each section starts a new page, so a chapter's opening page holds only its title, reading list, and roadmap
\newcommand{\sectionbreak}{\clearpage}
\titleformat{\subsection}{\normalfont\large\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}[runin]{\normalfont\normalsize\bfseries}{}{0pt}{}[.]

% Global counter shared by all numbered statements
\newcounter{stmt}
\numberwithin{equation}{chapter}
\numberwithin{figure}{chapter}
\numberwithin{table}{chapter}

\tcbset{
  nmbox/.style={
    enhanced,
    sharp corners, boxrule=0pt, frame hidden,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    before skip=10pt, after skip=10pt,
    parbox=false,
  }
}

% \NMboxed{env}{Name}{background}{title color}
\newcommand{\NMboxed}[4]{%
  \newenvironment{#1}[1][]{%
    \crefalias{stmt}{#1}\refstepcounter{stmt}%
    \tcolorbox[nmbox, colback=#3]%
    \setlength{\parindent}{0pt}%
    {\color{#4}\bfseries #2 \thestmt\ifx\relax##1\relax\else\ (##1)\fi}\par\smallskip
  }{\endtcolorbox}%
}
\definecolor{defbg}{RGB}{255,237,237}
\definecolor{deftitle}{RGB}{153,0,0}
\definecolor{thmbg}{RGB}{237,237,255}
\definecolor{thmtitle}{RGB}{0,0,255}
\definecolor{propbg}{RGB}{251,237,242}
\definecolor{proptitle}{RGB}{128,0,64}
\definecolor{exbg}{RGB}{240,248,236}
\definecolor{extitle}{RGB}{40,100,30}

\NMboxed{definition}{Definition}{defbg}{deftitle}
\NMboxed{theorem}{Theorem}{thmbg}{thmtitle}
\NMboxed{keypoint}{Key Point}{thmbg}{thmtitle}
\NMboxed{pitfall}{Pitfall}{propbg}{proptitle}
\NMboxed{exercise}{Exercise}{exbg}{extitle}

% Unboxed statements: bold run-in heading
% \NMplain{env}{Name}{body font}
\newcommand{\NMplain}[3]{%
  \newenvironment{#1}[1][]{%
    \par\medskip\crefalias{stmt}{#1}\refstepcounter{stmt}%
    \noindent{\bfseries #2 \thestmt}\ifx\relax##1\relax\else\ (##1)\fi{\bfseries.}\ #3%
  }{\par\medskip}%
}
\NMplain{example}{Example}{}
\NMplain{remark}{Remark}{}
\renewcommand{\qedsymbol}{$\square$}

% Solutions to recitation exercises: unnumbered run-in heading
\newenvironment{solution}{\par\smallskip\noindent{\bfseries\color{extitle}Solution.}\ }{\par\medskip}

% Cross references
\RequirePackage[colorlinks=true,linkcolor=blue,citecolor=blue,urlcolor=blue]{hyperref}
